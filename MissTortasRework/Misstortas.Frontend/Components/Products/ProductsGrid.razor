@using Misstortas.Frontend.Models
@using Misstortas.Frontend.Components.Products
@rendermode InteractiveServer

@if (Products is null)
{
    <p>Seleccione una categoria o busque por nombre para empezar.</p>
}
else if (!Products.Any())
{
    <p>No se encontraron productos.</p>
}
else
{
    <div class="row g-3">
        @foreach (var product in Products)
        {
            <div class="col-md-6 col-lg-4">
                <ProductCard Product="product" />
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public SaleProduct[]? Products { get; set; }
}