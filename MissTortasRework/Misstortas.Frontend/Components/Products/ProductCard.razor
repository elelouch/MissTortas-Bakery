@using Misstortas.Frontend.Models
@using Misstortas.Frontend.Services.Files
@using Misstortas.Frontend.Services.Products
@using Misstortas.Frontend.Services.Shared

@inject IFileUrlBuilder FileUrlBuilder
@inject ISaleProductCartService Cart
@inject IToastService ToastService

@rendermode InteractiveServer

<div class="card shadow-sm rounded-3 h-100">

    @if (Product.FilePaths.Any())
    {
        <img src="@FileUrlBuilder.GetUploadUrl(Product.FilePaths.First())"
             class="card-img-top"
             alt="@Product.Name"
             style="height:220px; object-fit:cover;" />
    }
    else
    {
        <div class="d-flex justify-content-center align-items-center bg-light"
             style="height:220px;">
            <span class="text-muted">Sin imagen</span>
        </div>
    }

    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Product.Name</h5>

        <div>
            <strong>Precio:</strong>
            @Product.SalePrice.ToString("C")
        </div>

        @if (Product.Quantity > 0)
        {
            <div class="mt-auto pt-3">
                <div class="input-group">

                    <button disabled="@(QuantityInput <= 0 || Cart.GetQuantityAsked(Product.Id) <= 0)"
                            class="btn btn-outline-secondary"
                            @onclick="Decrease">
                        -
                    </button>

                    <InputNumber @bind-Value="QuantityInput" min="0"
                                 class="form-control text-center"
                                 step="@Step" />

                    <button disabled="@(QuantityInput <= 0)"
                            class="btn btn-outline-primary"
                            @onclick="Increase">
                        +
                    </button>

                </div>
            </div>
        }
        else
        {
            <div class="mt-auto pt-3">
                <div class="alert alert-warning text-center mb-0">
                    <strong>Sin stock disponible</strong>
                </div>
            </div>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired]
    public SaleProduct Product { get; set; } = default!;

    private decimal _quantityInput;

    public decimal QuantityInput
    {
        get => _quantityInput;
        set
        {
            _quantityInput = Math.Max(0m, value);
        }
    }

    private string Step => Product.AllowDecimalAsk ? "0.1" : "1";


    private async Task Increase()
    {
        var lastQty = Cart.GetQuantityAsked(Product.Id);
        var newQuantity = lastQty + QuantityInput;

        if(!Product.AllowDecimalAsk && Math.Round(newQuantity) != newQuantity)
        {
            var errorMessage = $"La cantidad debe ser entera.";
            ToastService.Error(errorMessage);
            return;
        }

        if (newQuantity > Product.Quantity)
        {
            var errorMessage = $"Solo hay {Product.Quantity} disponibles en stock.";
            ToastService.Error(errorMessage);
            return;
        }

        var added = QuantityInput;

        await Cart.SetQuantity(Product, newQuantity);
        ToastService.Success($"Se agregaron {added} {Product.Name} al carrito. Total actual: {Cart.GetQuantityAsked(Product.Id)}");
    }

    private async Task Decrease()
    {
        var lastQty = Cart.GetQuantityAsked(Product.Id);
        var newQuantity = lastQty - QuantityInput;

        if(!Product.AllowDecimalAsk && Math.Round(newQuantity) != newQuantity)
        {
            var errorMessage = $"La cantidad debe ser entera.";
            ToastService.Error(errorMessage);
            return;
        }

        var removed = QuantityInput;

        if (newQuantity <= 0)
        {
            removed = lastQty;
            newQuantity = 0;
        }

        await Cart.SetQuantity(Product, newQuantity);
        ToastService.Info($"Se quitaron {removed} {Product.Name} del carrito. Total actual: {Cart.GetQuantityAsked(Product.Id)}");
    }
}
